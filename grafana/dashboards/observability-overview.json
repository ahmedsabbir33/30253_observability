{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "1. Host CPU Utilization (%)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "Decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"ubuntu-node-exporter\", mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "2. Host RAM Utilization (%)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "((node_memory_MemTotal_bytes{job=\"ubuntu-node-exporter\"} - node_memory_MemAvailable_bytes{job=\"ubuntu-node-exporter\"}) / node_memory_MemTotal_bytes{job=\"ubuntu-node-exporter\"}) * 100",
          "legendFormat": "RAM %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "3. Root Disk (/) Utilization (%)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "((node_filesystem_size_bytes{job=\"ubuntu-node-exporter\", mountpoint=\"/\"} - node_filesystem_avail_bytes{job=\"ubuntu-node-exporter\", mountpoint=\"/\"}) / node_filesystem_size_bytes{job=\"ubuntu-node-exporter\", mountpoint=\"/\"}) * 100",
          "legendFormat": "Root / %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "4. Host Uptime & Scrape Target Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "node_time_seconds{job=\"ubuntu-node-exporter\"} - node_boot_time_seconds{job=\"ubuntu-node-exporter\"}",
          "legendFormat": "Host Uptime",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(up)",
          "legendFormat": "Targets UP (of 2)",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "5. Host Network Traffic (Rx / Tx Bytes per Sec)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"ubuntu-node-exporter\", device!~\"lo|veth.*|docker.*|br-.*|cali.*\"}[1m]))",
          "legendFormat": "Rx {{device}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"ubuntu-node-exporter\", device!~\"lo|veth.*|docker.*|br-.*|cali.*\"}[1m]))",
          "legendFormat": "Tx {{device}}",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "6. Order API Request Rate (Requests / Sec)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(order_api_http_requests_total{job=\"order-api\"}[1m]))",
          "legendFormat": "Total RPS",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (route, status_code) (rate(order_api_http_requests_total{job=\"order-api\"}[1m]))",
          "legendFormat": "{{route}} [HTTP {{status_code}}]",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "7. Order API HTTP Failure / Error Rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 20 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(order_api_http_requests_total{job=\"order-api\", outcome=\"failure\"}[1m])) / clamp_min(sum(rate(order_api_http_requests_total{job=\"order-api\"}[1m])), 0.0001)) * 100",
          "legendFormat": "Failure Rate (%)",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "8. Order API p95 & p50 Request Latency (Seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_api_http_request_duration_seconds_bucket{job=\"order-api\", route=\"/api/orders\"}[1m])))",
          "legendFormat": "p95 Latency (/api/orders)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(order_api_http_request_duration_seconds_bucket{job=\"order-api\", route=\"/api/orders\"}[1m])))",
          "legendFormat": "p50 Latency (/api/orders)",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "9. Business Metrics: Orders Created & Failures by Reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (category) (order_api_orders_created_total{job=\"order-api\"})",
          "legendFormat": "Orders: {{category}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (reason) (order_api_order_failures_total{job=\"order-api\"})",
          "legendFormat": "Failures: {{reason}}",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "10. MicroK8s Workload Live Logs (Grafana Alloy -> Loki)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 20 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{namespace=\"order-workloads\", container=\"order-worker\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["observability", "candidate-30253", "prometheus", "loki", "microk8s"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
